  "homepage": "https://github.com/janis-commerce/serverless-plugin-remove-authorizer-permissions.git#readme",
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^2.4.1",
    "mocha": "^10.8.2",
    "nyc": "^15.1.0"
  },
  "files": [
    "lib/"
  ],
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "lodash.clonedeep": "^4.5.0"
  },
  "engines": {
    "node": ">=18"
