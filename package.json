{
  "name": "@janiscommerce/serverless-plugin-remove-authorizer-permissions",
  "version": "1.0.0",
  "description": "A Serverless Plugin to remove JANIS authorizers permissions",
  "main": "lib/serverless-plugin-remove-authorizer-permissions",
  "scripts": {
    "test": "export TEST_ENV=true; mocha --exit -R nyan --recursive tests/",
    "coverage-ci": "export TEST_ENV=true; nyc --reporter=lcov --reporter=text-summary mocha --exit --recursive tests/",
    "watch-test": "export TEST_ENV=true; mocha --exit -R nyan -w --recursive tests/",
    "coverage": "nyc npm test",
    "lint": "eslint lib/ tests/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janis-commerce/serverless-plugin-remove-authorizer-permissions.git"
  },
